# Copy this file to `.env` and fill in your values.

# LLM provider: "gemini" (free) or "anthropic" (paid Claude)
LLM_PROVIDER=gemini

# Google Gemini — FREE key, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Claude API key (only used if LLM_PROVIDER=anthropic) — https://console.anthropic.com/
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# Where the SQLite database lives
DATABASE_URL=sqlite:///data/jobs.db
